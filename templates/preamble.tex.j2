% ---------- Bloc de commande (utilisé par le DEX --- style "lstlisting",
%            aucun échappement LaTeX nécessaire pour son contenu, sûr pour
%            des commandes shell contenant _, %, $, {, }...) ----------
\lstdefinestyle{commandblock}{
  backgroundcolor=\color{codebg},
  basicstyle=\ttfamily\small,
  breaklines=true,
  columns=fullflexible,
  frame=none,
  xleftmargin=0.3cm,
  xrightmargin=0.3cm,
  framexleftmargin=0.3cm,
  framextopmargin=0.2cm,
  framexbottommargin=0.2cm,
}
\lstset{style=commandblock}

% ---------- Titres ----------
\titleformat{\chapter}[hang]{\Large\bfseries\color{primary}}{\thechapter.}{0.6em}{}
\titlespacing{\chapter}{0pt}{0pt}{1.2em}
\titleformat{\section}{\large\bfseries\color{accent}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries\color{graytxt}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\color{graytxt}}{\thesubsubsection}{0.6em}{}
\titleformat{\paragraph}{\normalsize\bfseries\itshape\color{graytxt}}{}{0em}{}
\titlespacing{\paragraph}{0pt}{0.8em}{0.4em}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}

